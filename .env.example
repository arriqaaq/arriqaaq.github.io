# Giscus comments — get these from https://giscus.app
# Connect your GitHub repo with Discussions enabled, then paste the values
# from the configuration script Giscus generates.
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=General
PUBLIC_GISCUS_CATEGORY_ID=

# Optional: override the default Ghost CDN tenant for image fetches
# GHOST_TENANT_BASE=https://storage.ghost.io/c/ce/b6/ceb66798-429b-432a-a02d-1c148871e2cf

# Optional: override the URL base path. Defaults to '' (root) for user/org
# GitHub Pages sites like arriqaaq.github.io. For project sites under a
# subpath, set BASE_PATH=/repo-name.
# BASE_PATH=
