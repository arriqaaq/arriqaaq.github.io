	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"migrate": "tsx scripts/migrate-to-markdown.ts",
		"parse": "tsx scripts/parse-content.ts",
		"fetch-images": "tsx scripts/fetch-drive-images.ts",
