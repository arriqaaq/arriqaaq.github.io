		"gray-matter": "^4.0.3",
		"js-yaml": "^4.1.1",
		"lowlight": "^3.3.0",
		"mdast-util-to-string": "^4.0.0",
		"node-html-parser": "^7.1.0",
		"pagefind": "^1.5.2",
		"rehype-highlight": "^7.0.2",
		"rehype-raw": "^7.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-directive": "^4.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-parse": "^11.0.0",
